{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run build:worker)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(git push *)",
      "Bash(npx wrangler *)",
      "Bash(curl *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)"
    ]
  }
}