ipts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n12:[\"$\",\"$2\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"bg-ssl-light-bg py-24 sm:py-32\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-4 sm:px-6\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-fluid-h1 font-display font-bold text-ssl-bg mb-8\",\"children\":\"Privacy Policy\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-600 mb-12 italic\",\"children\":[\"Last updated: \",\"September 11, 2026\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate prose-lg max-w-none text-slate-600 space-y-8\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Signal Strait Labs (\\\"we\\\", \\\"us\\\", \\\"our\\\") respects your privacy. This policy explains what information we collect, how we use it, and what rights you have over it.\"}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"1. Who We Are\"}],[\"$\",\"p\",null,{\"children\":\"Signal Strait Labs is a digital transformation and growth engineering company based in Nairobi, Kenya. If you have questions about this policy or your data, contact us at connect@signalstraitlabs.com.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"2. Information We Collect\"}],[\"$\",\"p\",null,{\"children\":\"When you use our contact form, we collect the information you provide: your name, email address, company name, service interest, message, and budget range. If you don't fill in every field, that's fine, only name, email, and message are required.\"}],[\"$\",\"p\",null,{\"children\":\"We also use privacy-focused analytics (Cloudflare Web Analytics) to understand how visitors use our site. This does not use cookies or track you individually across other websites.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"3. How We Use Your Information\"}],[\"$\",\"p\",null,{\"children\":\"We use the information you send us to respond to your inquiry, understand your needs, and follow up about potential work together. We do not sell your information to anyone.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"4. Who We Share Information With\"}],[\"$\",\"p\",null,{\"children\":\"We use Resend to deliver emails, so your contact form submission passes through their systems as part of sending it to us. We do not share your information with any other third party except where required by law.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"5. International Data Transfers\"}],[\"$\",\"p\",null,{\"children\":\"Because we work with clients and use services based outside Kenya, your information may be processed in other countries, including the United States and the European Union. Where this happens, we rely on the service providers' own data protection safeguards.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"6. How Long We Keep Your Information\"}],[\"$\",\"p\",null,{\"children\":\"We keep contact form submissions for as long as needed to respond to your inquiry and maintain a record of business communications, typically no longer than [X months/years — confirm actual retention practice].\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"7. Your Rights\"}],[\"$\",\"p\",null,{\"children\":\"Depending on where you're located, you may have the right to:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Ask what personal information we hold about you\"}],[\"$\",\"li\",null,{\"children\":\"Ask us to correct inaccurate information\"}],\"$L17\",\"$L18\",\"$L19\"]}],\"$L1a\",\"$L1b\"]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"]}]]}]}],null,\"$L20\"]}]\n14:[\"$\",\"$2\",\"h\",{\"children\":[null,[\"$\",\"$L21\",null,{\"children\":\"$L22\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L23\",null,{\"children\":[\"$\",\"$24\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L25\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n16:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2-y3a2mlckcq0.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n26:I[97367,[\"/_next/static/chunks/3fntmmi971322.js\",\"/_next/static/chunks/2x1wr9aax_k65.js\"],\"OutletBoundary\"]\n13:C\n17:[\"$\",\"li\",null,{\"children\":\"Ask us to delete your information\"}]\n18:[\"$\",\"li\",null,{\"children\":\"Object to how we use your information\"}]\n19:[\"$\",\"li\",null,{\"children\":\"Ask for a copy of your information in a portable format\"}]\n1a:[\"$\",\"p\",null,{\"children\":\"If you're in the European Union, these rights come from the GDPR. If you're in South Africa, these rights come from POPIA, and you can also lodge a complaint with the Information Regulator. If you're in Kenya, these rights are protected under the Data Protection Act, 2019, and you can contact the Office of the Data Protection Commissioner.\"}]\n1b:[\"$\",\"p\",null,{\"children\":\"To exercise any of these rights, email us at connect@signalstraitlabs.com.\"}]\n1c:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"8. Security\"}],[\"$\",\"p\",null,{\"children\":\"We take reasonable technical and organizational measures to protect your information from unauthorized access, loss, or misuse.\"}]]}]\n1d:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"9. Children's Privacy\"}],[\"$\",\"p\",null,{\"children\":\"Our services are intended for businesses and professionals, not children. We do not knowingly collect information from anyone under 18.\"}]]}]\n1e:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"10. Changes to This Policy\"}],[\"$\",\"p\",null,{\"children\":\"We may update this policy from time to time. If we make significant changes, we'll update the date at the top of this page.\"}]]}]\n1f:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-display font-bold text-ssl-bg mb-4\",\"children\":\"11. Contact Us\"}],[\"$\",\"p\",null,{\"children\":[\"Signal Strait Labs\",[\"$\",\"br\",null,{}],\"Thome, Nairobi, Kenya\",[\"$\",\"br\",null,{}],\"Email: connect@signalstraitlabs.com\",[\"$\",\"br\",null,{}],\"Phone: +254 712 895 903\"]}]]}]\n20:[\"$\",\"$L26\",null,{\"children\":[\"$\",\"$24\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@27\"}]}]\n22:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n28:I[27201,[\"/_next/static/chunks/3fntmmi971322.js\",\"/_next/static/chunks/2x1wr9aax_k65.js\"],\"IconMark\"]\n25:[[\"$\",\"title\",\"0\",{\"children\":\"Privacy Policy | Signal Strait Labs | Signal Strait Labs\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Privacy policy for Signal Strait Labs. Learn about how we handle your data.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"application-name\",\"content\":\"Signal Strait Labs\"}],[\"$\",\"link\",\"3\",{\"rel\":\"author\