.1s\"},\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-4 text-2xl font-bold text-ssl-bg\",\"children\":\"Our Approach\"}],[\"$\",\"div\",null,{\"className\":\"glass-card-light rounded-xl p-8\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-slate-600 leading-relaxed\",\"children\":\"We connect your tools with automated workflows, so data moves between systems on its own. If two platforms can share information, we make sure they do.\"}]}]]}]}],[\"$\",\"$L20\",\"The Outcome\",{\"variant\":\"slide-up\",\"style\":{\"animationDelay\":\"0.2s\"},\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-4 text-2xl font-bold text-ssl-bg\",\"children\":\"The Outcome\"}],[\"$\",\"div\",null,{\"className\":\"glass-card-light rounded-xl p-8\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-slate-600 leading-relaxed\",\"children\":\"Less manual work, fewer errors, and a clear, live view of what's happening across your business.\"}]}]]}]}]],[\"$\",\"$L20\",null,{\"variant\":\"slide-up\",\"style\":{\"animationDelay\":\"0.3s\"},\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-8 text-2xl font-bold text-ssl-bg text-center\",\"children\":\"Common Questions\"}],[\"$\",\"$L22\",null,{\"items\":[{\"question\":\"What if our tools weren't built to connect with each other?\",\"answer\":\"Most tools have an API or support a connector platform like Zapier or Make. We find the best route to connect them, even when it's not obvious.\"},{\"question\":\"Will this replace our current software?\",\"answer\":\"No. We connect what you already use so it works together. We only recommend replacing a tool if it's genuinely holding you back.\"},{\"question\":\"How much manual work can actually be automated?\",\"answer\":\"It depends on your setup, but most businesses we work with cut a significant amount of repetitive data entry within the first month.\"}]}]]}]}]]}],[\"$\",\"$L20