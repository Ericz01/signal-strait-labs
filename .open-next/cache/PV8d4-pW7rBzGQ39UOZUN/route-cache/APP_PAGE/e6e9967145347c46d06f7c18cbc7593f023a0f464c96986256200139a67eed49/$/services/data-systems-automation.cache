4xl px-4 sm:px-6\",\"children\":[[\"$\",\"$L2\",null,{\"variant\":\"slide-up\",\"children\":[\"$\",\"div\",null,{\"className\":\"mb-12 flex flex-col items-center text-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-ssl-blue/10 text-ssl-blue\",\"children\":[\"$\",\"$L3\",null,{\"icon\":{\"name\":\"chart-no-axes-column-increasing\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M5 21v-6\",\"key\":\"1hz6c0\"}],[\"path\",{\"d\":\"M12 21V9\",\"key\":\"uvy0l4\"}],[\"path\",{\"d\":\"M19 21V3\",\"key\":\"11j9sm\"}]],\"aliases\":[\"bar-chart\"]},\"className\":\"h-8 w-8\"}]}],[\"$\",\"h1\",null,{\"className\":\"mb-4 text-4xl font-bold tracking-tight text-ssl-bg md:text-5xl\",\"children\":\"Data Systems & Automation\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-slate-600\",\"children\":\"We design robust data architectures, custom robust API frameworks, and advanced low-code/no-code automated pipelines that link siloed internal software tools, completely eliminating manual data overhead.\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"space-y-16\",\"children\":[[[\"$\",\"$L2\",\"The Problem\",{\"variant\":\"slide-up\",\"style\":{\"animationDelay\":\"0s\"},\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-4 text-2xl font-bold text-ssl-bg\",\"children\":\"The Problem\"}],[\"$\",\"div\",null,{\"className\":\"glass-card-light rounded-xl p-8\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-slate-600 leading-relaxed\",\"children\":\"Growing companies often run on tools that don't talk to each other. Someone ends up copying data by hand between systems, and mistakes creep in.\"}]}]]}]}],[\"$\",\"$L2\",\"Our Approach\",{\"variant\":\"slide-up\",\"style\":{\"animationDelay\":\"0.1s\"},\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-4 text-2xl font-bold text-ssl-bg\",\"children\":\"Our Approach\"}],[\"$\",\"div\",null,{\"className\":\"glass-card-light rounded-xl p-8\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-slate-600 leading-relaxed\",\"children\":\"We connect your tools with automated workflows, so data moves between systems on its own. If two platforms can share information, we make sure they do.\"}]}]]}]}],[\"$\",\"$L2\",\"The Outcome\",{\"variant\":\"slide-up\",\"style\":{\"animationDelay\":\"0.2s\"},\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-4 text-2xl font-bold text-ssl-bg\",\"children\":\"The Outcome\"}],[\"$\",\"div\",null,{\"className\":\"glass-card-light rounded-xl p-8\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-slate-600 leading-relaxed\",\"children\":\"Less manual work, fewer errors, and a clear, live view of what's happening across your business.\"}]}]]}]}]],[\"$\",\"$L2\",null,{\"variant\":\"slide-up\",\"style\":{\"animationDelay\":\"0.3s\"},\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-8 text-2xl font-bold text-ssl-bg text-center\",\"children\":\"Common Questions\"}],[\"$\",\"$L4\",null,{\"items\":[{\"question\":\"What if our tools weren't built to connect with each other?\",\"answer\":\"Most tools have an API or support a connector platform like Zapier or Make. We find the best route to connect them, even when it's not obvious.\"},{\"question\":\"Will this replace our current software?\",\"answer\":\"No. We connect what you already use so it works together. We only recommend replacing a tool if it's genuinely holding you back.\"},{\"question\":\"How much manual work can actually be automated?\",\"answer\":\"It depends on your setup, but most businesses we work with cut a significant amount of repetitive data entry within the first month.\"}]}]]}]}]]}],[\"$\",\"$L2\",null,{\"variant\":\"slide-up\",\"className\":\"mt-20\",\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-8 text-center text-2xl font-bold text-ssl-bg\",\