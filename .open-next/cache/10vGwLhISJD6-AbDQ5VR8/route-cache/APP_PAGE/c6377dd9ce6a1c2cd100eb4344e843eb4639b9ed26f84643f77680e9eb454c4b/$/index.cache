alAddress\",\"streetAddress\":\"Thome\",\"addressLocality\":\"Nairobi\",\"addressRegion\":\"Nairobi County\",\"addressCountry\":\"KE\"},\"telephone\":\"+254712895903\",\"email\":\"connect@signalstraitlabs.com\",\"areaServed\":[{\"@type\":\"Country\",\"name\":\"Kenya\"},{\"@type\":\"Continent\",\"name\":\"Africa\"}],\"priceRange\":\"$$\",\"serviceType\":[\"Websites & Web Apps\",\"Search & AI Visibility (SEO/AEO/GEO)\",\"Data Systems & Automation\",\"Revenue Operations (RevOps)\",\"Performance Marketing & ABM\",\"PR & Reputation\",\"Marketing & Sales Team Training\"],\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Services\",\"itemListElement\":[{\"@type\":\"Offer\",\"position\":1,\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Websites & Web Apps\",\"description\":\"Fast, edge-native websites and web apps built with Next.js for African mobile networks, with Paystack, Flutterwave and CRM integrations.\",\"url\":\"https://signalstraitlabs.com/services/technical-infrastructure-web-dev\"}},{\"@type\":\"Offer\",\"position\":2,\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Search & AI Visibility (SEO/AEO/GEO)\",\"description\":\"Technical SEO, AEO and GEO that help your business rank in search and get cited by AI answer engines like ChatGPT, Gemini and Perplexity.\",\"url\":\"https://signalstraitlabs.com/services/algorithmic-search\"}},{\"@type\":\"Offer\",\"position\":3,\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Data Systems & Automation\",\"description\":\"Data architecture, APIs and automated pipelines that connect your internal tools and remove manual data work.\",\"url\":\"https://signalstraitlabs.com/services/data-systems-automation\"}},{\"@type\":\"Offer\",\"position\":4,\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Revenue Operations (RevOps)\",\"description\":\"CRM setup in HubSpot, Zoho or Salesforce, attribution dashboards and lead scoring that remove friction from your sales pipeline.\",\"url\":\"https://signalstraitlabs.com/services/