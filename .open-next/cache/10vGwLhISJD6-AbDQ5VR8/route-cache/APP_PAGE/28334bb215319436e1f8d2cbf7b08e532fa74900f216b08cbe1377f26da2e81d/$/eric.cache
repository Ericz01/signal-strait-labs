https://schema.org\",\"@type\":\"Person\",\"name\":\"Eric Nyaga\",\"givenName\":\"Eric\",\"familyName\":\"Nyaga\",\"jobTitle\":[\"Founder, Signal Strait Labs\",\"Central Marketing Officer and Lead Martech, Indepth Research Institute\"],\"url\":\"https://signalstraitlabs.com/eric\",\"image\":\"https://signalstraitlabs.com/eric/portrait.jpg\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Nairobi\",\"addressCountry\":\"KE\"},\"worksFor\":[{\"@type\":\"Organization\",\"name\":\"Signal Strait Labs\",\"url\":\"https://signalstraitlabs.com\"},{\"@type\":\"Organization\",\"name\":\"Indepth Research Institute\"}],\"alumniOf\":[{\"@type\":\"CollegeOrUniversity\",\"name\":\"University of the People\"},{\"@type\":\"CollegeOrUniversity\",\"name\":\"Zetech University\"}]}</script><section aria-labelledby=\"eric-hero-heading\" class=\"relative isolate overflow-hidden bg-ssl-bg\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10\"><div class=\"grid-pattern-dark absolute inset-0 [mask-image:radial-gradient(ellipse_at_30%_20%,#000_20%,transparent_75%)]\"></div><div class=\"absolute inset-0 bg-[radial-gradient(48rem_30rem_at_15%_-5%,rgba(26,89,204,0.35),transparent_70%),radial-gradient(36rem_24rem_at_95%_30%,rgba(26,89,204,0.18),transparent_70%)]\"></div><svg class=\"absolute inset-0 h-full w-full \" viewBox=\"0 0 1200 700\" preserveAspectRatio=\"xMidYMid slice\" fill=\"none\"><defs><linearGradient id=\"eric-line\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\"><stop offset=\"0\" stop-color=\"#1a59cc\" stop-opacity=\"0\"></stop><stop offset=\"0.55\" stop-color=\"#1a59cc\" stop-opacity=\"0.5\"></stop><stop offset=\"1\" stop-color=\"#1a59cc\" stop-opacity=\"0\"></stop></linearGradient></defs><path d=\"M-20 520 C 220 520, 300 380, 520 380 S 860 250, 1220 250\" stroke=\"url(#eric-line)\" stroke-width=\"1\"></path><path d=\"M-20 600 C 260 600, 420 470, 640 470 S 980 360, 1220 330\" stroke=\"url(#eric-line)\" stroke-width=\"1\"></path><path d=\"M-20 430 C 200 430, 340 290, 560 300 S 900 140, 1220 120\" stroke=\"url(#eric-line)\" stroke-width=\"1\"></path></svg><svg class=\"absolute inset-0 h-full w-full eric-pulse\" viewBox=\"0 0 1200 700\" preserveAspectRatio=\"xMidYMid slice\" fill=\"none\"><defs><linearGradient id=\"eric-gold-0\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\"><stop offset=\"0\" stop-color=\"#C5A059\" stop-opacity=\"0\"></stop><stop offset=\"0.55\" stop-color=\"#F1DCA7\" stop-opacity=\"0.7\"></stop><stop offset=\"1\" stop-color=\"#C5A059\" stop-opacity=\"0\"></stop></linearGradient></defs><path d=\"M-20 520 C 220 520, 300 380, 520 380 S 860 250, 1220 250\" stroke=\"url(#eric-gold-0)\" stroke-width=\"1.5\"></path></svg><svg class=\"absolute inset-0 h-full w-full eric-pulse\" viewBox=\"0 0 1200 700\" preserveAspectRatio=\"xMidYMid slice\" fill=\"none\"><defs><linearGradient id=\"eric-gold-1\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\"><stop offset=\"0\" stop-color=\"#C5A059\" stop-opacity=\"0\"></stop><stop offset=\"0.55\" stop-color=\"#F1DCA7\" stop-opacity=\"0.7\"></stop><stop offset=\"1\" stop-color=\"#C5A059\" stop-opacity=\"0\"></stop></linearGradient></defs><path d=\"M-20 600 C 260 600, 420 470, 640 470 S 980 360, 1220 330\" stroke=\"url(#eric-gold-1)\" stroke-width=\"1.5\"></path></svg><svg class=\"absolute inset-0 h-full w-full eric-pulse\" viewBox=\"0 0 1200 700\" preserveAspectRatio=\"xMidYMid slice\" fill=\"none\"><defs><linearGradient id=\"eric-gold-2\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\"><stop offset=\"0\" stop-color=\"#C5A059\" stop-opacity=\"0\"></stop><stop offset=\"0.55\" stop-color=\"#F1DCA7\" stop-opacity=\"0.7\"></stop><stop offset=\"1\" stop-color=\"#C5A059\" stop-opacity=\"0\"></stop></linearGradient></defs><path d=\"M-20 430 C 200 430, 340 290, 560 300 S 900 140, 1220 120\" stroke=\"url(#eric-gold-2)\" stroke-width=\"1.5\"></path></svg><div class=\"absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-ssl-bg\"></div></div><div class=\"mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-12 sm:px-6 md:grid-cols-[1.2fr_0.8fr] md:gap-14 md:pb-24 md:pt-20 lg:gap-20\"><div class=\"order-2 md:order-1\"><p class=\"mb-6 text-xs font-semibold uppercase leading-relaxed tracking-[0.2em] text-ssl-gold\">Marketing and Growth Leader · Founder, Signal Strait Labs</p><h1 id=\"eric-hero-heading\" class=\"text-[2.35rem] font-bold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-[3.6rem]\">I lead marketing, and I build the systems behind it.</h1><p class=\"mt-6 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg\">I&#x27;m Eric Nyaga. I set marketing direction, run sales and CRM operations, and write the code and automations that make the plan actually work. I do this as Central Marketing Officer at Indepth Research Institute, and for clients through Signal Strait Labs, the firm I founded.</p><div class=\"mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap\"><a href=\"#leadership\" class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ssl-gold focus-visible:ring-offset-2 focus-visible:ring-offset-ssl-bg bg-ssl-gold text-ssl-bg hover:bg-[#d4b273]\">Hiring for a senior role?<svg aria-hidden=\"true\" viewBox=\"0 0 20 20\" class=\"h-4 w-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M10 4v12m0 0 5-5m-5 5-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a><a href=\"#work-with-me\" class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ssl-gold focus-visible:ring-offset-2 focus-visible:ring-offset-ssl-bg border border-white/15 bg-ssl-blue text-white hover:bg-[#2266e0]\">Need growth work done?<svg aria-hidden=\"true\" viewBox=\"0 0 20 20\" class=\"h-4 w-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M10 4v12m0 0 5-5m-5 5-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a></div><a href=\"/eric/eric-nyaga-cv.pdf?v=1\" download=\"Eric-Nyaga-CV.pdf\" class=\"mt-5 inline-flex items-center gap-2 rounded text-sm font-semibold text-slate-200 underline decoration-ssl-gold/50 underline-offset-4 transition-colors hover:text-white hover:decoration-ssl-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ssl-gold focus-visible:ring-offset-2 focus-visible:ring-offset-ssl-bg\">Download CV<span class=\"text-slate-400\">(PDF)</span></a></div><div class=\"order-1 mx-auto w-full max-w-[16rem] sm:max-w-[20rem] md:order-2 md:max-w-none\"><div class=\"relative\"><div aria-hidden=\"true\" class=\"eric-portrait-glow absolute -inset-10 -z-10 rounded-full opacity-90\"></div><div class=\"relative aspect-[4/5] overflow-hidden rounded-[1.75rem] border border-ssl-gold/30 bg-ssl-bg shadow-[0_30px_80px_-30px_rgba(26,89,204,0.7)]\"><img alt=\"Portrait of Eric Nyaga\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/eric/portrait.jpg?v=1\"/><div aria-hidden=\"true\" class=\"absolute inset-0 rounded-[1.75rem] ring-1 ring-inset ring-white/10\"></div></div></div></div></div><div class=\"border-y border-white/[0.06] bg-white/[0.015]\"><div class=\"mx-auto flex max-w-6xl flex-col gap-3 px-4 py-5 sm:px-6 md:flex-row md:items-center md:gap-8\"><p class=\"shrink-0 text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-400\">Where I work</p><ul class=\"flex flex-wrap items-center gap-x-6 gap-y-2\"><li class=\"flex items-center\"><span class=\"font-display text-sm font-semibold tracking-tight text-slate-200\">Signal Strait Labs</span></li><li class=\"flex items-center\"><span class=\"font-display text-sm font-semibold tracking-tight text-slate-200\">IRES</span></li><li class=\"flex items-center\"><span class=\"font-display text-sm font-semibold tracking-tight text-slate-200\">Apollina Healthcare</span></li><li class=\"flex items-center\"><span class=\"font-display text-sm font-semibold tracking-tight text-slate-200\">Oplos Marketing &amp; Media</span></li></ul></div></div></section><section id=\"how-i-think\" aria-labelledby=\"eric-principles-heading\" class=\"relative scroll-mt-24 px-4 py-20 sm:px-6 md:py-28\"><div class=\"mx-auto max-w-6xl\"><div class=\"max-w-3xl\"><p class=\"mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-ssl-gold\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-ssl-gold/60\"></span>How I think</p><h2 id=\"eric-principles-heading\" class=\"text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-[2.75rem] md:leading-[1.1]\">Four rules I work by.</h2></div><ol class=\"mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/[0.07] bg-white/[0.07] md:grid-cols-2\"><li class=\"reveal reveal-fade flex gap-5 bg-ssl-bg p-7 sm:p-9\"><span aria-hidden=\"true\" class=\"font-display text-sm font-semibold tabular-nums text-ssl-gold\">01</span><div><h3 class=\"text-xl font-semibold leading-snug tracking-tight text-white\">Marketing is a system, not a stream of posts.</h3><p class=\"mt-3 leading-relaxed text-slate-300\">Every campaign should feed a pipeline that someone owns. Every lead should have a clear next step. If a post doesn&#x27;t lead anywhere, it&#x27;s decoration.</p></div></li><li class=\"reveal reveal-fade flex gap-5 bg-ssl-bg p-7 sm:p-9\"><span aria-hidden=\"true\" class=\"font-display text-sm font-semibold tabular-nums text-ssl-gold\">02</span><div><h3 class=\"text-xl font-semibold leading-snug tracking-tight text-white\">If it isn&#x27;t in the CRM, it didn&#x27;t happen.</h3><p class=\"mt-3 leading-relaxed text-slate-300\">I set up tracking before I spend money. That way we can tell which channel brought a paying client, not just which one got clicks.</p></div></li><li class=\"reveal reveal-fade flex gap-5 bg-ssl-bg p-7 sm:p-9\"><span aria-hidden=\"true\" class=\"font-display text-sm font-semibold tabular-nums text-ssl-gold\">03</span><div><h3 class=\"text-xl font-semibold leading-snug tracking-tight text-white\">Speed and follow-up beat volume.</h3><p class=\"mt-3 leading-relaxed text-slate-300\">A warm lead left for two weeks is a lost lead. I design follow-up so response speed matches how ready the buyer is.</p></div></li><li class=\"reveal reveal-fade flex gap-5 bg-ssl-bg p-7 sm:p-9\"><span aria-hidden=\"true\" class=\"font-display text-sm font-semibold tabular-nums text-ssl-gold\">04</span><div><h3 class=\"text-xl font-semibold leading-snug tracking-tight text-white\">Build for the team you have.</h3><p class=\"mt-3 leading-relaxed text-slate-300\">The best tool is the one your team will actually use. I automate the repetitive work so people can focus on the conversations that close.</p></div></li></ol></div></section><section id=\"roles\" aria-labelledby=\"eric-roles-heading\" class=\"relative scroll-mt-24 px-4 py-20 sm:px-6 md:py-28 bg-[linear-gradient(180deg,transparent,rgba(26,89,204,0.06),transparent)]\"><div class=\"mx-auto max-w-6xl\"><div class=\"max-w-3xl\"><p class=\"mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-ssl-gold\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-ssl-gold/60\"></span>Current roles</p><h2 id=\"eric-roles-heading\" class=\"text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-[2.75rem] md:leading-[1.1]\">Where I work now</h2></div><ul class=\"mt-14 grid gap-5 sm:grid-cols-2\"><li class=\"reveal reveal-slide-up eric-card eric-card-hover flex flex-col rounded-2xl p-7\"><div class=\"flex items-start justify-between gap-4\"><p class=\"text-xs font-semibold uppercase tracking-[0.18em] text-ssl-gold\">Signal Strait Labs</p><p class=\"shrink-0 text-xs font-medium tabular-nums text-slate-400\">2022 to now</p></div><h3 class=\"mt-4 text-xl font-semibold tracking-tight text-white\">Founder</h3><p class=\"mt-3 leading-relaxed text-slate-300\">I run the firm, shape client strategy and lead the builds.</p></li><li class=\"reveal reveal-slide-up eric-card eric-card-hover flex flex-col rounded-2xl p-7\"><div class=\"flex items-start justify-between gap-4\"><p class=\"text-xs font-semibold uppercase tracking-[0.18em] text-ssl-gold\">Indepth Research Institute (IRES)</p><p class=\"shrink-0 text-xs font-medium tabular-nums text-slate-400\">Current</p></div><h3 class=\"mt-4 text-xl font-semibold tracking-tight text-white\">Central Marketing Officer and Lead Martech</h3><p class=\"mt-3 leading-relaxed text-slate-300\">I lead marketing across the institute&#x27;s sector units, run the CRM and reporting to management, and support sales execution.</p><p class=\"mt-5 border-t border-white/[0.07] pt-4 text-sm leading-relaxed text-slate-400\"><span class=\"text-slate-300\">About the organization: </span>IRES has served 200,000+ professionals across 17+ sectors and 21+ countries.</p></li><li class=\"reveal reveal-slide-up eric-card eric-card-hover flex flex-col rounded-2xl p-7\"><div class=\"flex items-start justify-between gap-4\"><p class=\"text-xs font-semibold uppercase tracking-[0.18em] text-ssl-gold\">Apollina Healthcare</p><p class=\"shrink-0 text-xs font-medium tabular-nums text-slate-400\">Current</p></div><h3 class=\"mt-4 text-xl font-semibold tracking-tight text-white\">Marketing Lead, part-time</h3><p class=\"mt-3 leading-relaxed text-slate-300\">I run marketing, search visibility and target account planning across African markets.</p></li><li class=\"reveal reveal-slide-up eric-card eric-card-hover flex flex-col rounded-2xl p-7\"><div class=\"flex items-start justify-between gap-4\"><p class=\"text-xs font-semibold uppercase tracking-[0.18em] text-ssl-gold\">Oplos Marketing &amp; Media</p><p class=\"shrink-0 text-xs font-medium tabular-nums text-slate-400\">Current</p></div><h3 class=\"mt-4 text-xl font-semibold tracking-tight text-white\">Marketing Lead, part-time</h3><p class=\"mt-3 leading-relaxed text-slate-300\">I run marketing, paid ads and search visibility for the brand.</p></li></ul></div></section><section id=\"work\" aria-labelledby=\"eric-work-heading\" class=\"relative scroll-mt-24 px-4 py-20 sm:px-6 md:py-28\"><div class=\"mx-auto max-w-6xl\"><div class=\"max-w-3xl\"><p class=\"mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-ssl-gold\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-ssl-gold/60\"></span>Selected work</p><h2 id=\"eric-work-heading\" class=\"text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-[2.75rem] md:leading-[1.1]\">Real projects, start to finish.</h2><p class=\"mt-5 text-base leading-relaxed text-slate-300 sm:text-lg\">Each one follows the same format: the problem, my role, what I decided, what I built and what happened.</p></div><div class=\"mt-12\"><div><div role=\"group\" aria-label=\"Filter projects\" class=\"-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:flex-wrap sm:px-0\"><button type=\"button\" aria-pressed=\"true\" class=\"min-h-11 shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ssl-gold focus-visible:ring-offset-2 focus-visible:ring-offset-ssl-bg border-ssl-gold bg-ssl-gold text-ssl-bg\">All</button><button type=\"button\" aria-pressed=\"false\" class=\"min-h-11 shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ssl-gold focus-visible:ring-offset-2 focus-visible:ring-offset-ssl-bg border-white/15 text-slate-200 hover:border-white/40 hover:text-white\">Strategy and Leadership</button><button type=\"button\" aria-pressed=\"false\" class=\"min-h-11 shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ssl-gold focus-visible:ring-offset-2 focus-visible:ring-offset-ssl-bg border-white/15 text-slate-200 hover:border-white/40 hover:text-white\">Systems and Automation</button><button type=\"button\" aria-pressed=\"false\" class=\"min-h-11 shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ssl-gold focus-visible:ring-offset-2 focus-visible:ring-offset-ssl-bg border-white/15 text-slate-200 hover:border-white/40 hover:text-white\">Campaigns</button><button type=\"button\" aria-pressed=\"false\" class=\"min-h-11 shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ssl-gold focus-visible:ring-offset-2 focus-visible:ring-offset-ssl-bg border-white/15 text-slate-200 hover:border-white/40 hover:text-white\">Engineering</button></div><p class=\"sr-only\" aria-live=\"polite\">9<!-- --> <!-- -->projects<!-- --> shown</p><ul class=\"mt-8 grid gap-5 sm:grid-cols-2\"><li class=\"sm:col-span-2\"><article class=\"eric-card eric-card-hover group relative h-full overflow-hidden rounded-2xl\"><div class=\"flex h-full flex-col lg:flex-row\"><div class=\"relative shrink-0 overflow-hidden border-b border-white/[0.06] bg-[#06112e] lg:w-[58%] lg:border-b-0 lg:border-r\" style=\"aspect-ratio:16 / 10\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/eric/work/railsite-1.jpg?v=1\"/></div><div class=\"flex flex-1 flex-col p-6 sm:p-7 lg:justify-center lg:p-10\"><p class=\"text-xs font-semibold uppercase tracking-[0.16em] text-ssl-gold\">A growing construction firm</p><h3 class=\"mt-3 text-xl font-semibold leading-snug tracking-tight text-white lg:text-2xl\">Autonomous social media for a construction firm</h3><p class=\"mt-3 flex-1 leading-relaxed text-slate-300\">A daily posting system that runs on free tools, with almost no staff time from the client.</p><div class=\"mt-6 flex flex-wrap items-center justify-between gap-3\"><ul class=\"flex flex-wrap gap-1.5\" aria-label=\"Tags\"><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Systems and Automation</li><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Engineering</li></ul><span aria-hidden=\"true\" class=\"inline-flex items-center gap-1.5 text-sm font-semibold text-white\">Read the case study<svg viewBox=\"0 0 20 20\" class=\"h-4 w-4 text-ssl-gold transition-transform group-hover:translate-x-1 motion-reduce:transition-none\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10h12m0 0-5-5m5 5-5 5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></div></div><button type=\"button\" aria-haspopup=\"dialog\" aria-label=\"Read the case study: Autonomous social media for a construction firm\" class=\"absolute inset-0 rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ssl-gold\"></button></article></li><li class=\"\"><article class=\"eric-card eric-card-hover group relative h-full overflow-hidden rounded-2xl\"><div class=\"flex h-full flex-col\"><div class=\"relative shrink-0 overflow-hidden border-b border-white/[0.06] bg-[#06112e]\" style=\"aspect-ratio:16 / 10\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/eric/work/lead-framework-1.jpg?v=1\"/></div><div class=\"flex flex-1 flex-col p-6 sm:p-7\"><p class=\"text-xs font-semibold uppercase tracking-[0.16em] text-ssl-gold\">Indepth Research Institute (IRES)</p><h3 class=\"mt-3 text-xl font-semibold leading-snug tracking-tight text-white\">Lead management framework for a training institute</h3><p class=\"mt-3 flex-1 leading-relaxed text-slate-300\">Clear lead stages, owners and response times between marketing and sales, run in HubSpot.</p><div class=\"mt-6 flex flex-wrap items-center justify-between gap-3\"><ul class=\"flex flex-wrap gap-1.5\" aria-label=\"Tags\"><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Strategy and Leadership</li></ul><span aria-hidden=\"true\" class=\"inline-flex items-center gap-1.5 text-sm font-semibold text-white\">Read the case study<svg viewBox=\"0 0 20 20\" class=\"h-4 w-4 text-ssl-gold transition-transform group-hover:translate-x-1 motion-reduce:transition-none\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10h12m0 0-5-5m5 5-5 5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></div></div><button type=\"button\" aria-haspopup=\"dialog\" aria-label=\"Read the case study: Lead management framework for a training institute\" class=\"absolute inset-0 rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ssl-gold\"></button></article></li><li class=\"\"><article class=\"eric-card eric-card-hover group relative h-full overflow-hidden rounded-2xl\"><div class=\"flex h-full flex-col\"><div class=\"relative shrink-0 overflow-hidden border-b border-white/[0.06] bg-[#06112e]\" style=\"aspect-ratio:16 / 10\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/eric/work/course-finder-1.jpg?v=1\"/></div><div class=\"flex flex-1 flex-col p-6 sm:p-7\"><p class=\"text-xs font-semibold uppercase tracking-[0.16em] text-ssl-gold\">IRES, healthcare and humanitarian units</p><h3 class=\"mt-3 text-xl font-semibold leading-snug tracking-tight text-white\">Course Finder and Training Needs Assessment tools</h3><p class=\"mt-3 flex-1 leading-relaxed text-slate-300\">Adaptive question tools that recommend courses, capture the lead and hand back a PDF report.</p><div class=\"mt-6 flex flex-wrap items-center justify-between gap-3\"><ul class=\"flex flex-wrap gap-1.5\" aria-label=\"Tags\"><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Engineering</li><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Systems and Automation</li></ul><span aria-hidden=\"true\" class=\"inline-flex items-center gap-1.5 text-sm font-semibold text-white\">Read the case study<svg viewBox=\"0 0 20 20\" class=\"h-4 w-4 text-ssl-gold transition-transform group-hover:translate-x-1 motion-reduce:transition-none\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10h12m0 0-5-5m5 5-5 5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></div></div><button type=\"button\" aria-haspopup=\"dialog\" aria-label=\"Read the case study: Course Finder and Training Needs Assessment tools\" class=\"absolute inset-0 rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ssl-gold\"></button></article></li><li class=\"\"><article class=\"eric-card eric-card-hover group relative h-full overflow-hidden rounded-2xl\"><div class=\"flex h-full flex-col\"><div class=\"relative shrink-0 overflow-hidden border-b border-white/[0.06] bg-[#06112e]\" style=\"aspect-ratio:16 / 10\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/eric/work/dashboard-1.jpg?v=1\"/></div><div class=\"flex flex-1 flex-col p-6 sm:p-7\"><p class=\"text-xs font-semibold uppercase tracking-[0.16em] text-ssl-gold\">Indepth Research Institute (IRES)</p><h3 class=\"mt-3 text-xl font-semibold leading-snug tracking-tight text-white\">Management marketing dashboard and monthly reporting</h3><p class=\"mt-3 flex-1 leading-relaxed text-slate-300\">One weekly view of marketing across six platforms for the CEO and management, built on free tools.</p><div class=\"mt-6 flex flex-wrap items-center justify-between gap-3\"><ul class=\"flex flex-wrap gap-1.5\" aria-label=\"Tags\"><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Strategy and Leadership</li></ul><span aria-hidden=\"true\" class=\"inline-flex items-center gap-1.5 text-sm font-semibold text-white\">Read the case study<svg viewBox=\"0 0 20 20\" class=\"h-4 w-4 text-ssl-gold transition-transform group-hover:translate-x-1 motion-reduce:transition-none\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10h12m0 0-5-5m5 5-5 5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></div></div><button type=\"button\" aria-haspopup=\"dialog\" aria-label=\"Read the case study: Management marketing dashboard and monthly reporting\" class=\"absolute inset-0 rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ssl-gold\"></button></article></li><li class=\"\"><article class=\"eric-card eric-card-hover group relative h-full overflow-hidden rounded-2xl\"><div class=\"flex h-full flex-col\"><div class=\"relative shrink-0 overflow-hidden border-b border-white/[0.06] bg-[#06112e]\" style=\"aspect-ratio:16 / 10\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/eric/work/paid-ads-1.jpg?v=1\"/></div><div class=\"flex flex-1 flex-col p-6 sm:p-7\"><p class=\"text-xs font-semibold uppercase tracking-[0.16em] text-ssl-gold\">IRES, Apollina Healthcare, Oplos Marketing &amp; Media</p><h3 class=\"mt-3 text-xl font-semibold leading-snug tracking-tight text-white\">Paid advertising and attribution system</h3><p class=\"mt-3 flex-1 leading-relaxed text-slate-300\">A reusable model for ad budgets, UTM naming and HubSpot attribution across three brands.</p><div class=\"mt-6 flex flex-wrap items-center justify-between gap-3\"><ul class=\"flex flex-wrap gap-1.5\" aria-label=\"Tags\"><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Strategy and Leadership</li><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Campaigns</li></ul><span aria-hidden=\"true\" class=\"inline-flex items-center gap-1.5 text-sm font-semibold text-white\">Read the case study<svg viewBox=\"0 0 20 20\" class=\"h-4 w-4 text-ssl-gold transition-transform group-hover:translate-x-1 motion-reduce:transition-none\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10h12m0 0-5-5m5 5-5 5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></div></div><button type=\"button\" aria-haspopup=\"dialog\" aria-label=\"Read the case study: Paid advertising and attribution system\" class=\"absolute inset-0 rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ssl-gold\"></button></article></li><li class=\"\"><article class=\"eric-card eric-card-hover group relative h-full overflow-hidden rounded-2xl\"><div class=\"flex h-full flex-col\"><div class=\"relative shrink-0 overflow-hidden border-b border-white/[0.06] bg-[#06112e]\" style=\"aspect-ratio:16 / 10\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/eric/work/logistics-ads-2.jpg?v=1\"/></div><div class=\"flex flex-1 flex-col p-6 sm:p-7\"><p class=\"text-xs font-semibold uppercase tracking-[0.16em] text-ssl-gold\">Two Nairobi logistics firms</p><h3 class=\"mt-3 text-xl font-semibold leading-snug tracking-tight text-white\">Lead generation for logistics companies</h3><p class=\"mt-3 flex-1 leading-relaxed text-slate-300\">Meta lead campaigns for customs and freight clients, with every lead sent straight into follow-up.</p><div class=\"mt-6 flex flex-wrap items-center justify-between gap-3\"><ul class=\"flex flex-wrap gap-1.5\" aria-label=\"Tags\"><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Campaigns</li><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Systems and Automation</li></ul><span aria-hidden=\"true\" class=\"inline-flex items-center gap-1.5 text-sm font-semibold text-white\">Read the case study<svg viewBox=\"0 0 20 20\" class=\"h-4 w-4 text-ssl-gold transition-transform group-hover:translate-x-1 motion-reduce:transition-none\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10h12m0 0-5-5m5 5-5 5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></div></div><button type=\"button\" aria-haspopup=\"dialog\" aria-label=\"Read the case study: Lead generation for logistics companies\" class=\"absolute inset-0 rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ssl-gold\"></button></article></li><li class=\"\"><article class=\"eric-card eric-card-hover group relative h-full overflow-hidden rounded-2xl\"><div class=\"flex h-full flex-col\"><div class=\"relative shrink-0 overflow-hidden border-b border-white/[0.06] bg-[#06112e]\" style=\"aspect-ratio:16 / 10\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/eric/work/content-plan-1.jpg?v=1\"/></div><div class=\"flex flex-1 flex-col p-6 sm:p-7\"><p class=\"text-xs font-semibold uppercase tracking-[0.16em] text-ssl-gold\">Indepth Research Institute (IRES)</p><h3 class=\"mt-3 text-xl font-semibold leading-snug tracking-tight text-white\">Rebuilding the marketing team&#x27;s content plan</h3><p class=\"mt-3 flex-1 leading-relaxed text-slate-300\">A content plan that goes past course promotion into proof, people and expertise.</p><div class=\"mt-6 flex flex-wrap items-center justify-between gap-3\"><ul class=\"flex flex-wrap gap-1.5\" aria-label=\"Tags\"><li class=\"rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-300\">Strategy and Leadership</li></ul><span aria-hidden=\"true\" class=\"inline-flex items-center gap-1.5 text-sm font-semibold text-white\">Read the case study<svg viewBox=\"0 0 20 20\" class=\"h-4 w-4 text-ssl-gold transition-transform group-hover:translate-x-1 motion-reduce:transition-none\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10h12m0 0-5-5m5 5-5 5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></div></div><button type=\"button\" aria-haspopup=\"dialog\" aria-label=\"Read the case study: Rebuilding the marketing team&#x27;s content plan