,\"h2\",null,{\"id\":\"eric-principles-heading\",\"className\":\"text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-[2.75rem] md:leading-[1.1]\",\"children\":\"Four rules I work by.\"}],\"$undefined\"]}],[\"$\",\"ol\",null,{\"className\":\"mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/[0.07] bg-white/[0.07] md:grid-cols-2\",\"children\":[[\"$\",\"li\",\"Marketing is a system, not a stream of posts.\",{\"className\":\"reveal reveal-fade flex gap-5 bg-ssl-bg p-7 sm:p-9\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"font-display text-sm font-semibold tabular-nums text-ssl-gold\",\"children\":\"01\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold leading-snug tracking-tight text-white\",\"children\":\"Marketing is a system, not a stream of posts.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 leading-relaxed text-slate-300\",\"children\":\"Every campaign should feed a pipeline that someone owns. Every lead should have a clear next step. If a post doesn't lead anywhere, it's decoration.\"}]]}]],\"ref\":null}],[\"$\",\"li\",\"If it isn't in the CRM, it didn't happen.\",{\"className\":\"reveal reveal-fade flex gap-5 bg-ssl-bg p-7 sm:p-9\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"font-display text-sm font-semibold tabular-nums text-ssl-gold\",\"children\":\"02\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold leading-snug tracking-tight text-white\",\"children\":\"If it isn't in the CRM, it didn't happen.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 leading-relaxed text-slate-300\",\"children\":\"I set up tracking before I spend money. That way we can tell which channel brought a paying client, not just which one got clicks.\"}]]}]],\"ref\":null}],[\"$\",\"li\",\"Speed and follow-up beat volume.\",{\"className\":\"reveal reveal-fade flex gap-5 bg-ssl-bg p-7 sm:p-9\",\"children\":[[\"$\