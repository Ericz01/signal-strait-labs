nt=\"https://signalstraitlabs.com/eric/og-eric.png?v=1\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Eric Nyaga, Marketing and Growth Leader, Founder of Signal Strait Labs\"/><meta property=\"og:type\" content=\"profile\"/><meta property=\"profile:first_name\" content=\"Eric\"/><meta property=\"profile:last_name\" content=\"Nyaga\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Eric Nyaga | Marketing and Growth Leader, Founder of Signal Strait Labs\"/><meta name=\"twitter:description\" content=\"Eric Nyaga leads marketing, sales operations and CRM at Indepth Research Institute and founded Signal Strait Labs. He sets the direction and builds the systems behind it. Based in Nairobi, Kenya.\"/><meta name=\"twitter:image\" content=\"https://signalstraitlabs.com/eric/og-eric.png?v=1\"/><meta name=\"twitter:image:alt\" content=\"Eric Nyaga, Marketing and Growth Leader, Founder of Signal Strait Labs\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.3bllcdmcy15c7.ico\" sizes=\"32x32\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/icon.svg?icon.2gig1cffsr4w_.svg\" sizes=\"any\" type=\"image/svg+xml\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png?apple-icon.3lykizilqzuvr.png\" sizes=\"180x180\" type=\"image/png\"/><script>try{var c=localStorage.getItem('ssl-cookie-consent');if(c==='accepted'||c==='declined')document.documentElement.setAttribute('data-consent',c)}catch(e){}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"bg-ssl-light-bg text-ssl-bg antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"flex min-h-screen flex-col luxury-bg-gradient selection:bg-ssl-blue/20\"><header class=\"sticky top-0 z-50 border-b transition-all durati